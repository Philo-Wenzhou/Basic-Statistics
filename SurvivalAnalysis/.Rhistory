# 1. 加载包+数据
library(survival)  # 生存分析核心包
data(veteran)      # 加载肺癌老兵数据
# 2. 数据预处理：添加id、排除缺失、计算中位生存时间
veteran_td <- veteran %>%
mutate(
id = 1:nrow(.),  # 手动添加患者ID（关键：标识同一患者的不同时间区间）
status = as.integer(status)  # 确保事件状态为整数（1=死亡，0=删失）
) %>%
na.omit()  # 排除缺失值
median_surv <- median(veteran_td$time)  # 计算中位生存时间（约120天）
# 3. 构造时间依变数据：拆分随访区间
veteran_td_split <- lapply(unique(veteran_td$id), function(pat_id) {
# 提取单个患者数据
pat <- veteran_td[veteran_td$id == pat_id, ]
# 第一段区间：start=0，stop=min(中位时间, 患者实际生存时间)
seg1 <- data.frame(
id = pat$id,
start = 0,
stop = min(median_surv, pat$time),
status = ifelse(pat$time <= median_surv, pat$status, 0),  # 事件若在第一段发生，标记为1
trt = pat$trt,  # 治疗组（1=标准，2=试验）
age = pat$age,  # 年龄（固定协变量，不随时间变）
karno = pat$karno  # 第一段体力评分（原始值）
)
# 第二段区间：仅对随访超中位时间的患者，start=中位时间，stop=实际时间
if (pat$time > median_surv) {
seg2 <- data.frame(
id = pat$id,
start = median_surv,
stop = pat$time,
status = pat$status,  # 事件若在第二段发生，标记为1
trt = pat$trt,
age = pat$age,
karno = pat$karno - 8  # 时间依变：第二段体力评分降低8分（模拟随时间下降）
)
return(rbind(seg1, seg2))  # 合并两段数据
} else {
return(seg1)  # 仅返回第一段
}
}) %>% do.call(rbind, .)  # 合并所有患者的区间数据
# 4. 拟合时间依变协变量Cox模型
td_cox_model <- coxph(
formula = Surv(start, stop, status) ~ trt + age + karno,  # karno为时间依变协变量
data = veteran_td_split
)
# 5. 查看结果（重点关注karno的风险比）
cat("=== 时间依变协变量Cox模型结果 ===\n")
summary(td_cox_model)
# 提取风险比及95%置信区间（更易解读）
cat("\n=== 风险比（HR）及95%置信区间 ===\n")
exp(cbind(HR = coef(td_cox_model), confint(td_cox_model)))
veteran
veteran
# 1. 加载必需包
library(survival)  # 自带生存分析工具，含veteran数据集
veteran  # 加载肺癌老兵数据
data(cancer, package="survival")
# 2. 数据预处理：添加id、排除缺失、计算中位生存时间
veteran_td <- veteran %>%
mutate(
id = 1:nrow(.),  # 手动添加患者ID（关键：标识同一患者的不同时间区间）
status = as.integer(status)  # 确保事件状态为整数（1=死亡，0=删失）
) %>%
na.omit()  # 排除缺失值
median_surv <- median(veteran_td$time)  # 计算中位生存时间（约120天）
# 3. 构造时间依变数据：拆分随访区间
veteran_td_split <- lapply(unique(veteran_td$id), function(pat_id) {
# 提取单个患者数据
pat <- veteran_td[veteran_td$id == pat_id, ]
# 第一段区间：start=0，stop=min(中位时间, 患者实际生存时间)
seg1 <- data.frame(
id = pat$id,
start = 0,
stop = min(median_surv, pat$time),
status = ifelse(pat$time <= median_surv, pat$status, 0),  # 事件若在第一段发生，标记为1
trt = pat$trt,  # 治疗组（1=标准，2=试验）
age = pat$age,  # 年龄（固定协变量，不随时间变）
karno = pat$karno  # 第一段体力评分（原始值）
)
# 第二段区间：仅对随访超中位时间的患者，start=中位时间，stop=实际时间
if (pat$time > median_surv) {
seg2 <- data.frame(
id = pat$id,
start = median_surv,
stop = pat$time,
status = pat$status,  # 事件若在第二段发生，标记为1
trt = pat$trt,
age = pat$age,
karno = pat$karno - 8  # 时间依变：第二段体力评分降低8分（模拟随时间下降）
)
return(rbind(seg1, seg2))  # 合并两段数据
} else {
return(seg1)  # 仅返回第一段
}
}) %>% do.call(rbind, .)  # 合并所有患者的区间数据
# 4. 拟合时间依变协变量Cox模型
td_cox_model <- coxph(
formula = Surv(start, stop, status) ~ trt + age + karno,  # karno为时间依变协变量
data = veteran_td_split
)
# 5. 查看结果（重点关注karno的风险比）
cat("=== 时间依变协变量Cox模型结果 ===\n")
summary(td_cox_model)
# 提取风险比及95%置信区间（更易解读）
cat("\n=== 风险比（HR）及95%置信区间 ===\n")
exp(cbind(HR = coef(td_cox_model), confint(td_cox_model)))
# 1. 安装并加载包（cmprsk为竞争风险专用包）
if (!require(cmprsk)) install.packages("cmprsk")
library(cmprsk)
library(survival)  # 加载cancer数据集
# 2. 加载数据+预处理（定义竞争事件）
data(cancer)
cancer_cr <- cancer %>%
# 筛选核心变量（排除无关变量）
select(time, status, age, sex, ph.ecog) %>%
na.omit() %>%  # 排除缺失值
mutate(
# 重新编码事件状态：0=删失，1=肺癌死亡（关注事件），2=其他死亡（竞争事件）
event = case_when(
status == 1 ~ 0,        # 原status=1为删失
status == 2 & ph.ecog >= 1 ~ 1,  # 体力差（ph.ecog≥1）的死亡视为肺癌死亡（关注事件）
status == 2 & ph.ecog == 0 ~ 2   # 体力好（ph.ecog=0）的死亡视为其他死亡（竞争事件）
),
sex = factor(sex, levels = 1:2, labels = c("Male", "Female")),  # 性别因子化（便于解读）
ph.ecog = factor(ph.ecog, levels = 0:3, labels = c("0=正常", "1=轻微受限", "2=明显受限", "3=卧床"))
) %>%
filter(event != 99)  # 排除异常值（若有）
# 3. 拟合竞争风险模型（关注事件：肺癌死亡，event=1）
cr_model <- crr(
ftime = cancer_cr$time,    # 随访时间
fstatus = cancer_cr$event, # 事件状态（0=删失，1=关注事件，2=竞争事件）
cov1 = cancer_cr[, c("age", "sex", "ph.ecog")],  # 纳入的协变量
failcode = 1  # 明确“关注事件”的编码
)
